{
  "name": "pierocampos_backend",
  "version": "1.0.0",
  "description": "Backend Piero de Campos — integração Segfy (módulo isolado)",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "postinstall": "npm run build && npm run playwright:chromium",
    "playwright:chromium": "playwright install chromium",
    "test": "vitest run",
    "test:watch": "vitest",
    "segfy:mapear": "tsx src/scripts/mapear-segfy.ts",
    "segfy:mapear:auto": "tsx src/scripts/mapear-segfy-auto.ts",
    "segfy:descobrir-auth": "tsx src/scripts/descobrir-auth.ts",
    "segfy:analisar": "tsx src/scripts/analisar-mapa.ts",
    "segfy:cotar": "tsx src/scripts/cotar-auto.ts",
    "segfy:harness": "tsx src/scripts/segfy-harness.ts",
    "segfy:reauth": "tsx src/scripts/segfy-reauth.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HvcamposHAi/PieroCampos_Backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/HvcamposHAi/PieroCampos_Backend/issues"
  },
  "homepage": "https://github.com/HvcamposHAi/PieroCampos_Backend#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.99.0",
    "@supabase/supabase-js": "^2.46.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@whiskeysockets/baileys": "6.7.23",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "helmet": "^8.0.0",
    "playwright": "^1.48.2",
    "socket.io-client": "^4.8.3",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^2.1.5"
  }
}
