# ============================================================
# Segfy — credenciais (preencher .env local; NUNCA commitar)
# ============================================================
SEGFY_LOGIN=comercial1@pierodecampos.com.br
SEGFY_SENHA=

# Base URL da API — gateway UpFy confirmado via mapeamento (27/05/2026).
# (paths de negócio ainda PENDENTES de captura interativa: `npm run segfy:mapear`)
SEGFY_API_URL=https://upfygate.segfy.com

# ⚠️ 2FA por e-mail a partir de 01/06/2026: login programático (API/scraper)
# passa a exigir código enviado ao e-mail cadastrado. Avaliar usuário de API
# isento (Configurações > Usuários) ou API oficial antes de habilitar.

# URL da SPA (usada pelo scraper e pelo mapeamento)
SEGFY_APP_URL=https://app.segfy.com

# Feature flag — nada chama o Segfy real enquanto for false
SEGFY_ENABLED=false

# Polling de cotação (HFy/Multify)
SEGFY_COTACAO_TIMEOUT_MS=60000
SEGFY_COTACAO_INTERVAL_MS=3000

# Scraper Playwright
SEGFY_HEADLESS=true

# Nível de log: debug | info | warn | error
LOG_LEVEL=info

# ============================================================
# Supabase — usado pelo FUTURO adapter de persistência (fora do
# módulo isolado atual; o módulo grava via persistence.port.ts).
# ============================================================
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
